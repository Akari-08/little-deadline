# Copy to .env (gitignored). Never put real values in this example file.
# App-wide Claude API key for Ask Sprout, so users don't need their own. Host-only; never sent to the browser.
ANTHROPIC_API_KEY=
# Other credentials (device, Canvas, Notion, Spotify) are entered in Settings, not here.
# Override the local HTTP port if 3210 is occupied.
LIL_DEADLINE_PORT=
# Empty uses the existing per-user TaskPet directory (preserves existing data).
TASKPET_DATA_DIR=
# Optional absolute path to a Python 3 executable for computer-webcam gestures.
LIL_DEADLINE_PYTHON=
